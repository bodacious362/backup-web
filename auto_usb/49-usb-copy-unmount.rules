// Allow the USB Copy web user to start/stop only the USB mount units.
// @INSTALL_USER@ is replaced by set-up.sh.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    var mount = unit.indexOf("usb-mount@") === 0;
    var unmount = unit.indexOf("usb-unmount@") === 0;
    var okVerb =
        verb === "" ||
        verb === "start" ||
        (mount && (verb === "stop" || verb === "restart"));
    if (subject.user === "@INSTALL_USER@" && (mount || unmount) && okVerb) {
        return polkit.Result.YES;
    }
});
