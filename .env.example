# Copy to .env and adjust. The server reads these on startup.

# Directory that holds the folders you copy FROM.
SOURCE_BASE=/mnt/MEDIA

# Directory where USB drives are mounted (one sub-directory per drive).
MOUNT_BASE=/mnt

# Port the web server listens on.
PORT=3001

# Bind address. 127.0.0.1 = local only (safest). 0.0.0.0 = reachable on your LAN.
HOST=127.0.0.1